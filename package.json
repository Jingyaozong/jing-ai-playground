{
  "name": "jing-ai-playground",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "briefing:review": "node scripts/briefing/review-server.mjs",
    "briefing:sources": "node scripts/briefing/cli.mjs sources",
    "briefing:demo": "node scripts/briefing/cli.mjs demo",
    "briefing:collect": "node scripts/briefing/cli.mjs collect",
    "briefing:draft": "node --env-file-if-exists=.env.local scripts/briefing/cli.mjs draft",
    "verify:briefing": "node --test scripts/briefing/pipeline.test.mjs scripts/briefing/run-guard.test.mjs scripts/briefing/selection.test.mjs scripts/briefing/review-page.test.mjs scripts/briefing/review-client.test.mjs scripts/briefing/draft-records.test.mjs scripts/briefing/draft-page.test.mjs scripts/briefing/remark-client.test.mjs",
    "verify:briefing-export": "node --test scripts/briefing/export.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "verify:content": "node --experimental-strip-types scripts/verify-content-integrity.mjs",
    "verify:practice-pack": "node scripts/verify-rule-knowledge-pack.mjs",
    "verify:rule-review": "node --experimental-strip-types --test scripts/verify-rule-review.test.mjs",
    "verify:multimodal-evaluation": "node --experimental-strip-types --test scripts/verify-multimodal-evaluation.test.mjs",
    "verify:agent-trace": "node --experimental-strip-types --test scripts/verify-agent-trace.test.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "verify:pages:repository": "node scripts/verify-repository-pages.mjs",
    "verify:upload-readiness": "node scripts/verify-upload-readiness.mjs",
    "verify:navigation": "node --experimental-strip-types --test scripts/verify-navigation.test.mjs",
    "verify:release": "npm run lint && npm run typecheck && npm run verify:content && npm run verify:practice-pack && npm run verify:rule-review && npm run verify:multimodal-evaluation && npm run verify:agent-trace && npm run build && npm run verify:pages && npm run verify:navigation && npm run verify:briefing && npm run verify:briefing-export && npm run verify:pages:repository",
    "verify:upload": "npm run verify:release && npm run verify:upload-readiness",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
